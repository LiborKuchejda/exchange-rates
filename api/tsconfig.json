{
  "compilerOptions": {
    "target": "esnext",
    "module": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}